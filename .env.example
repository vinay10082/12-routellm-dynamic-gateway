# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and should never be committed.

# --- LLM provider credentials (routed calls go through LiteLLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Routing targets ---
# LiteLLM-compatible model identifiers, e.g. "gpt-4-1106-preview" (strong)
# and "gpt-3.5-turbo" (weak), or "anthropic/claude-..." / "anyscale/...".
STRONG_MODEL_ENDPOINT=gpt-4-1106-preview
WEAK_MODEL_ENDPOINT=gpt-3.5-turbo

# --- Router behavior ---
# One of: mf, bert, causal_llm, sw_ranking, random
ROUTER_TYPE=mf
# Win-rate threshold (0-1) above which the strong model is used.
# 0.11593 is RouteLLM's default calibrated for ~50% GPT-4 call volume.
ROUTING_CONFIDENCE_THRESHOLD=0.11593

# --- Optional cost estimation (USD per 1k tokens); defaults to 0 if unset ---
STRONG_MODEL_PROMPT_PRICE_PER_1K=0.01
STRONG_MODEL_COMPLETION_PRICE_PER_1K=0.03
WEAK_MODEL_PROMPT_PRICE_PER_1K=0.0005
WEAK_MODEL_COMPLETION_PRICE_PER_1K=0.0015
